# Copy to .env and fill in your values

# LLM backend: "ollama" (native HTTP) or "litellm" (any provider/model).
# API key for the primary backend (litellm cloud providers). Leave blank for
# Ollama, or to let LiteLLM read OPENAI_API_KEY / ANTHROPIC_API_KEY itself.
LLM_API_BASE=http://localhost:11434
LLM_API_KEY=
LLM_BACKEND=ollama
LLM_MODEL="gemma4:12b"

# Max output tokens per call. Context window is NOT set here — it's decided by
# the Ollama server (OLLAMA_CONTEXT_LENGTH env or model Modelfile num_ctx);
# the OpenAI-compatible wire this app speaks has no per-request num_ctx.
LLM_NUM_PREDICT=4096

# Optional fallback backend — tried when the primary fails or returns empty.
# Has its own model/url/key; each defaults to the primary's value if left blank.
# Example: primary cloud litellm, fallback to local Ollama.
LLM_FALLBACK_BACKEND=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_BASE=
LLM_FALLBACK_API_KEY=

# Deprecated — kept as fallbacks if LLM_* are unset:
# OLLAMA_URL, OLLAMA_MODEL, OLLAMA_NUM_PREDICT

SEND_TELEGRAM=true
TELEGRAM_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

CACHE_MINUTES=30
ACTION_THRESHOLD_IDR=1000000

# Finnhub fallback (optional) — used only when yfinance fails or returns empty data.
# Absent key = fallback disabled. Get a free key at https://finnhub.io
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# ── Database (Postgres) ──
DATABASE_URL=postgresql://folionix:your_password@localhost:5432/folionix

# ── /aireview local read API (deployed web proxies latest weekly_review) ──
# The DB is not reachable from a dev machine; the local /aireview command curls
# the deployed web app instead. Set both here AND in the web deployment env.
FOLIONIX_WEB_URL=https://your-folionix-web-host
AIREVIEW_API_TOKEN=generate_a_long_random_secret

# LangGraph orchestrator settings
SIGNAL_PRICE_MINOR=3.0
SIGNAL_PRICE_MAJOR=5.0
SIGNAL_VOLUME_MINOR=1.5
SIGNAL_VOLUME_MAJOR=3.0
# Intervals are in MINUTES
GRAPH_ACTIVE_INTERVAL=5
GRAPH_IDLE_INTERVAL=30
GRAPH_ANALYSIS_INTERVAL=30
GRAPH_SEND_TELEGRAM=false

# News sentiment settings
NEWS_CACHE_HOURS=4
NEWS_FETCH_ENABLED=true

# ── Multi-agent deep runs (analysis_jobs queue + folionix-worker) ──
# Master gate: when true, MAJOR signals enqueue a multi-agent deep run
# (persona LLM calls + consensus) instead of the inline single pass.
DEEP_RUNS_ENABLED=false
# Enabled investor personas: comma list of names, or a number = first N.
# Full set: buffett,munger,graham,damodaran,burry,lynch,fisher,wood,ackman,pabrai,jhunjhunwala,druckenmiller
# Each persona is one serial Ollama call (~30s) — trim this to control runtime.
PERSONAS=
WORKER_POLL_SEC=10
WORKER_MAX_ATTEMPTS=3
# Minimum persona results required before consensus (default: half of enabled)
CONSENSUS_MIN_PERSONAS=
# Requeue jobs stuck in 'running' longer than this on worker start (minutes)
DEEP_RUN_STALE_MIN=120

# ── NextAuth (web UI authentication) ──
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Optional: set the base URL for NextAuth (defaults to NEXTAUTH_URL or auto-detected)
AUTH_URL=http://localhost:3000

# ── Gold price provider (Cermati) ──
CERMATI_GRAPHQL_URL=https://edge.cermati.com/graphql
CERMATI_COOKIE=

# ── Weekly-review email (Brevo SMTP; skipped when user/pass/EMAIL_TO unset) ──
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
